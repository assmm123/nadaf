    class="pointer-events-none fixed inset-x-0 top-4 z-[80] flex justify-center px-4"
>
    <div class="pointer-events-auto flex items-center gap-2 rounded-lg bg-navy-900 px-5 py-3 text-sm font-semibold text-white shadow-xl">
