    {{-- السلايدر --}}
    @if ($slides->isNotEmpty())
        <section class="container-x mt-4" x-data="{ slide: 0, total: {{ $slides->count() }}, start() { if (this.total > 1) setInterval(() => this.slide = (this.slide + 1) % this.total, 5000) } }" x-init="start()">
            <div class="relative aspect-[16/6] min-h-44 overflow-hidden rounded-2xl bg-navy-900 sm:aspect-[21/7]">
                @foreach ($slides as $i => $slide)
                    <a href="{{ $slide->link ?: '#' }}"
                       class="absolute inset-0 transition-opacity duration-700"
                       :class="slide === {{ $i }} ? 'opacity-100 z-10' : 'opacity-0 z-0'"
                       @if(!($slide->link)) tabindex="-1" @endif>
                        @if ($slide->videoUrl())
                            <video src="{{ $slide->videoUrl() }}" autoplay muted loop playsinline class="h-full w-full object-cover"></video>
                        @elseif ($slide->imageUrl())
                            <img src="{{ $slide->imageUrl() }}" alt="{{ $slide->title ?? 'Slide' }}" class="h-full w-full object-cover">
                        @endif
                        @if ($slide->title)
                            <div class="absolute inset-0 flex items-center bg-gradient-to-t from-navy-950/80 to-transparent">
                                <h2 class="max-w-md px-6 text-2xl font-extrabold text-white sm:px-12 sm:text-4xl">{{ $slide->title }}</h2>
                            </div>
                        @endif
                    </a>
                @endforeach

                @if ($slides->count() > 1)
                    <div class="absolute bottom-3 z-20 flex gap-1.5 inset-x-0 justify-center">
                        @foreach ($slides as $i => $slide)
                            <button @click="slide = {{ $i }}" class="h-1.5 rounded-full transition-all {{ $loop->first ? 'w-6 bg-gold-500' : 'w-1.5 bg-white/50' }}:;" aria-label="Slide {{ $i + 1 }}"></button>
                        @endforeach
                    </div>
                @endif
            </div>
        </section>
    @endif

