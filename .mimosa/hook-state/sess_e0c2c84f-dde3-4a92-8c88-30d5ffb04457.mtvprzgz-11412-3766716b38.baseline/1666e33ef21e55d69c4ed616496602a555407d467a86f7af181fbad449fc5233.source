<div wire:key="floating-chat">
    {{-- زر الشات العائم --}}
    @if (! $open)
        <button wire:click="toggle" aria-label="فتح المحادثة"
                class="fixed bottom-5 end-5 z-[80] flex h-14 w-14 items-center justify-center rounded-full bg-navy-900 text-gold-400 shadow-xl transition hover:scale-105 hover:bg-navy-800">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor" class="h-6 w-6">
                <path stroke-linecap="round" stroke-linejoin="round" d="M8.625 12a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0Zm0 0H8.25m4.125 0a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0Zm0 0H12m4.125 0a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0Zm0 0h-.375M21 12c0 4.556-4.03 8.25-9 8.25a9.764 9.764 0 0 1-2.555-.337A5.972 5.972 0 0 1 5.41 20.97a5.969 5.969 0 0 1-.474-.065 4.48 4.48 0 0 0 .978-2.025c.09-.457-.133-.901-.467-1.226C3.93 16.178 3 14.189 3 12c0-4.556 4.03-8.25 9-8.25s9 3.694 9 8.25Z" />
            </svg>
            <span class="absolute -top-0.5 -end-0.5 h-3.5 w-3.5 rounded-full border-2 border-white bg-green-500"></span>
        </button>
    @endif

    {{-- نافذة المحادثة --}}
    @if ($open)
        <div class="fixed bottom-5 end-5 z-[80] flex h-[480px] w-[calc(100vw-2.5rem)] max-w-sm flex-col overflow-hidden rounded-2xl border border-gray-200 bg-white shadow-2xl" x-data x-cloak>
            <div class="flex items-center justify-between bg-navy-900 px-4 py-3">
                <div class="flex items-center gap-2.5">
                    <span class="flex h-9 w-9 items-center justify-center rounded-full bg-gold-500/20 text-gold-400">
                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor" class="h-5 w-5">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M8.625 12a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0Zm0 0H8.25m4.125 0a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0Zm0 0H12m4.125 0a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0Zm0 0h-.375M21 12c0 4.556-4.03 8.25-9 8.25a9.764 9.764 0 0 1-2.555-.337A5.972 5.972 0 0 1 5.41 20.97a5.969 5.969 0 0 1-.474-.065 4.48 4.48 0 0 0 .978-2.025c.09-.457-.133-.901-.467-1.226C3.93 16.178 3 14.189 3 12c0-4.556 4.03-8.25 9-8.25s9 3.694 9 8.25Z" />
                        </svg>
                    </span>
                    <div>
                        <p class="text-sm font-extrabold text-white">مساعد نداف</p>
                        <p class="text-[10px] text-green-400">● متصل الآن — رد فوري</p>
                    </div>
                </div>
                <button wire:click="toggle" class="rounded p-1 text-white/70 hover:bg-white/10 hover:text-white" aria-label="إغلاق">✕</button>
            </div>

            {{-- الرسائل --}}
            <div class="flex-1 space-y-3 overflow-y-auto bg-cream/40 p-3" wire:key="chat-msgs">
                @foreach ($messages as $i => $msg)
                    <div class="{{ $msg['from'] === 'user' ? 'flex justify-end' : 'flex justify-start' }}" wire:key="msg-{{ $i }}">
                        <div class="{{ $msg['from'] === 'user'
                            ? 'rounded-2xl rounded-te-md bg-navy-900 text-white'
                            : 'rounded-2xl rounded-ts-md border border-gray-100 bg-white text-navy-900' }} max-w-[85%] px-3.5 py-2.5 text-sm leading-6 whitespace-pre-line shadow-sm">
                            {{ $msg['text'] }}

                            @if (isset($msg['suggestions']))
                                <div class="mt-2.5 flex flex-wrap gap-1.5">
                                    @foreach ($msg['suggestions'] as $s)
                                        <button wire:click="ask(@js($s))"
                                                class="rounded-full border border-gold-500 bg-gold-100/60 px-3 py-1 text-xs font-bold text-gold-700 transition hover:bg-gold-200">
                                            {{ $s }}
                                        </button>
                                    @endforeach
                                </div>
                            @endif

                            @if (isset($msg['show_contact']) && $msg['show_contact'])
                                {{-- وسائل التواصل بأيقونات كبيرة — تظهر عند تكرار السؤال أو غياب الجواب --}}
                                <div class="mt-3 grid grid-cols-2 gap-2">
                                    @foreach (\App\Models\CommunicationMethod::where('is_active', true)->orderBy('sort_order')->get() as $cm)
                                        <a href="{{ $cm->link() }}" target="_blank" rel="noopener"
                                           class="flex flex-col items-center gap-1.5 rounded-xl border border-gray-100 bg-gradient-to-b from-white to-gray-50 py-3 transition hover:-translate-y-0.5 hover:border-gold-500 hover:shadow-md">
                                            <span class="flex h-11 w-11 items-center justify-center rounded-full bg-navy-900 text-gold-400">
                                                <x-shop-icon name="{{ \App\Models\CommunicationMethod::TYPES[$cm->type]['icon'] ?? 'globe' }}" class="h-6 w-6" />
                                            </span>
                                            <span class="text-xs font-extrabold text-navy-900">{{ $cm->label ?? $cm->typeLabel() }}</span>
                                        </a>
                                    @endforeach
                                </div>
                            @endif
                        </div>
                    </div>
                @endforeach
            </div>

            {{-- الإدخال --}}
            <form wire:submit="ask" class="flex items-center gap-2 border-t border-gray-100 bg-white p-2.5">
                <input type="text" wire:model="message" placeholder="اكتب سؤالك..."
                       class="input flex-1 !rounded-full !py-2 text-sm" maxlength="300" autocomplete="off">
                <button type="submit" wire:loading.attr="disabled"
                        class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-gold-500 text-navy-900 transition hover:bg-gold-600" aria-label="إرسال">
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="h-4.5 w-4.5 rtl:-scale-x-100">
                        <path d="M3.478 2.405a.75.75 0 0 0-.926.94l2.432 7.905H13.5a.75.75 0 0 1 0 1.5H4.984l-2.432 7.905a.75.75 0 0 0 .926.94 60.519 60.519 0 0 0 18.445-8.986.75.75 0 0 0 0-1.218A60.517 60.517 0 0 0 3.478 2.405Z" />
                    </svg>
                </button>
            </form>
        </div>
    @endif
</div>
