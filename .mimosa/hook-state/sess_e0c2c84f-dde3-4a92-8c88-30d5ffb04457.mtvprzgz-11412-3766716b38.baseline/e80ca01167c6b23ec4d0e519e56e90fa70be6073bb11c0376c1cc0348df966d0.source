            <div class="space-y-4">
                @foreach ($sections as $key => $sec)
                    @php
                        $orders = (clone $sec['query'])(auth()->user()->orders()->withCount('items')->latest())->get();
                        $count = $orders->count();
                        if ($count === 0) continue;
                    @endphp
                    <details class="card group overflow-hidden p-0 ring-2 {{ $sec['ring'] }}" open wire:key="sec-{{ $key }}">
                        <summary class="flex cursor-pointer flex-wrap items-center gap-3 p-5 select-none">
