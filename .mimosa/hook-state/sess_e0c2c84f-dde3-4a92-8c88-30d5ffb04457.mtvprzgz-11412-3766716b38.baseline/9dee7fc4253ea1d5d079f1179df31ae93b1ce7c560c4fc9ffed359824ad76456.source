<div wire:key="cart-table">
    @if ($totals['items']->isEmpty())
        <div class="card flex flex-col items-center gap-4 p-12 text-center">
            <x-shop-icon name="bag" class="h-12 w-12 text-gray-200" />
            <div>
                <p class="text-lg font-extrabold">{{ __('cart.empty') }}</p>
                <p class="mt-1 text-sm text-gray-400">{{ __('cart.empty_desc') }}</p>
            </div>
            <a href="{{ route('home') }}" class="btn-gold">{{ __('cart.continue_shopping') }}</a>
        </div>
    @else
        <div class="flex flex-col gap-6 lg:flex-row">
            <div class="flex-1 space-y-3">
                @foreach ($totals['items'] as $item)
                    <div class="card flex items-center gap-4 p-4" wire:key="item-{{ $item->key }}">
                        @if ($img = $item->product->imageUrl())
                            <img src="{{ $img }}" alt="" class="h-20 w-20 shrink-0 rounded-lg object-cover">
                        @else
                            <div class="flex h-20 w-20 shrink-0 items-center justify-center rounded-lg bg-cream text-navy-200">
                                <x-shop-icon name="bag" class="h-7 w-7" />
                            </div>
                        @endif

                        <div class="min-w-0 flex-1">
                            <a href="{{ route('product.show', $item->product->slug) }}" class="line-clamp-1 font-bold hover:text-gold-600">
                                {{ $item->product->name }}
                            </a>
                            @if ($item->variant_label)
                                <p class="mt-0.5 text-xs text-gray-400">{{ $item->variant_label }}</p>
                            @endif
                            <p class="mt-1 text-sm font-bold text-gold-600">
                                {{ fmt_price($item->unit_usd, $item->unit_syp) }}
                            </p>
                            @if ($item->is_wholesale)
                                <span class="badge mt-1 bg-gold-100 text-gold-600">{{ __('cart.wholesale_applied') }}</span>
                            @endif
                        </div>

                        <div class="flex flex-col items-end gap-2">
                            <input type="number" min="1" class="input !w-20 !py-1.5 text-center"
                                   wire:model.live.debounce.400ms="qty.{{ $item->key }}">
                            <div class="flex items-center gap-3">
                                <span class="font-extrabold">{{ fmt_usd($item->line_usd) }}</span>
                                <button wire:click="remove('{{ $item->key }}')" wire:loading.attr="disabled"
                                        class="rounded p-1.5 text-red-400 hover:bg-red-50 hover:text-red-600"
                                        title="{{ __('cart.remove') }}">
                                    <x-shop-icon name="trash" class="h-4 w-4" />
                                </button>
                            </div>
                        </div>
                    </div>
                @endforeach
            </div>

            {{-- الملخص --}}
            <div class="lg:w-80 lg:shrink-0">
                <div class="card sticky top-32 space-y-3 p-5 text-sm">
