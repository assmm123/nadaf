                        <label class="label">إيصال الدفع (صورة أو PDF) <?php echo e($requiresProof ? '— أو رقم الحوالة' : ''); ?></label>
                        <input type="file" wire:model="proof" accept=".jpg,.jpeg,.png,.webp,.pdf"
                               class="block w-full text-sm file:me-3 file:rounded-lg file:border-0 file:bg-navy-900 file:px-4 file:py-2.5 file:text-white hover:file:bg-navy-800">
                        <?php if(\Livewire\Mechanisms\ExtendBlade\ExtendBlade::isRenderingLivewireComponent()): ?><!--[if BLOCK]><![endif]--><?php endif; ?><?php $__errorArgs = ['proof'];
$__bag = $errors->getBag($__errorArgs[1] ?? 'default');
if ($__bag->has($__errorArgs[0])) :
if (isset($message)) { $__messageOriginal = $message; }
$message = $__bag->first($__errorArgs[0]); ?> <p class="mt-1 text-xs text-red-600"><?php echo e($message); ?></p> <?php unset($message);
if (isset($__messageOriginal)) { $message = $__messageOriginal; }
endif;
unset($__errorArgs, $__bag); ?><?php if(\Livewire\Mechanisms\ExtendBlade\ExtendBlade::isRenderingLivewireComponent()): ?><!--[if ENDBLOCK]><![endif]--><?php endif; ?>
                        <p class="mt-1 text-[11px] text-gray-400">صورة أو PDF — بحد أقصى 5MB — تُحفظ بأمان وتراجعها الإدارة فقط</p>
                    </div>
                </div>
            </div>
        <?php endif; ?><?php if(\Livewire\Mechanisms\ExtendBlade\ExtendBlade::isRenderingLivewireComponent()): ?><!--[if ENDBLOCK]><![endif]--><?php endif; ?>

        
        <div class="card overflow-hidden">
            <div class="flex items-center gap-3 bg-navy-900 px-5 py-3">
                <span class="flex h-7 w-7 items-center justify-center rounded-full bg-gold-500 text-sm font-extrabold text-navy-900">4</span>
                <h3 class="font-extrabold text-white">خصومات وملاحظات</h3>
            </div>

            <div class="space-y-4 p-5">
                <div>
                    <label class="label"><?php echo e(__('checkout.coupon_code')); ?></label>
                    <div class="flex max-w-md gap-2">
                        <input type="text" wire:model="coupon_code" class="input" placeholder="<?php echo e(__('cart.coupon_placeholder')); ?>">
                        <button wire:click="applyCoupon" wire:loading.attr="disabled" class="btn-outline shrink-0"><?php echo e(__('cart.apply')); ?></button>
                    </div>
                    <?php if(\Livewire\Mechanisms\ExtendBlade\ExtendBlade::isRenderingLivewireComponent()): ?><!--[if BLOCK]><![endif]--><?php endif; ?><?php if($couponMessage): ?>
                        <p class="mt-2 text-xs font-bold <?php echo e($appliedCouponId ? 'text-green-600' : 'text-red-600'); ?>"><?php echo e($couponMessage); ?></p>
                    <?php endif; ?><?php if(\Livewire\Mechanisms\ExtendBlade\ExtendBlade::isRenderingLivewireComponent()): ?><!--[if ENDBLOCK]><![endif]--><?php endif; ?>
                    <?php if(\Livewire\Mechanisms\ExtendBlade\ExtendBlade::isRenderingLivewireComponent()): ?><!--[if BLOCK]><![endif]--><?php endif; ?><?php $__errorArgs = ['coupon_code'];
$__bag = $errors->getBag($__errorArgs[1] ?? 'default');
if ($__bag->has($__errorArgs[0])) :
if (isset($message)) { $__messageOriginal = $message; }
$message = $__bag->first($__errorArgs[0]); ?> <p class="mt-2 text-xs text-red-600"><?php echo e($message); ?></p> <?php unset($message);
if (isset($__messageOriginal)) { $message = $__messageOriginal; }
endif;
unset($__errorArgs, $__bag); ?><?php if(\Livewire\Mechanisms\ExtendBlade\ExtendBlade::isRenderingLivewireComponent()): ?><!--[if ENDBLOCK]><![endif]--><?php endif; ?>
                </div>

                <div>
                    <label class="label"><?php echo e(__('account.notes')); ?></label>
                    <textarea wire:model="notes" rows="2" class="input" placeholder="<?php echo e(__('checkout.notes_placeholder')); ?>"></textarea>
                </div>
            </div>
        </div>
    </div>

    
    <div class="lg:w-80 lg:shrink-0">
        <div class="card sticky top-32 space-y-3 p-5 text-sm">
            <h3 class="mb-2 font-extrabold"><?php echo e(__('checkout.title')); ?></h3>

            <div class="max-h-52 space-y-2 overflow-y-auto pe-1">
                <?php if(\Livewire\Mechanisms\ExtendBlade\ExtendBlade::isRenderingLivewireComponent()): ?><!--[if BLOCK]><![endif]--><?php endif; ?><?php $__currentLoopData = $totals['items']; $__env->addLoop($__currentLoopData); foreach($__currentLoopData as $item): $__env->incrementLoopIndices(); $loop = $__env->getLastLoop(); ?>
                    <div class="flex items-start justify-between gap-2" wire:key="sum-<?php echo e($item->key); ?>">
                        <span class="min-w-0">
                            <span class="line-clamp-1"><?php echo e($item->product->name); ?></span>
                            <span class="text-xs text-gray-400">× <?php echo e($item->qty); ?> <?php if(\Livewire\Mechanisms\ExtendBlade\ExtendBlade::isRenderingLivewireComponent()): ?><!--[if BLOCK]><![endif]--><?php endif; ?><?php if($item->variant_label): ?> (<?php echo e($item->variant_label); ?>) <?php endif; ?><?php if(\Livewire\Mechanisms\ExtendBlade\ExtendBlade::isRenderingLivewireComponent()): ?><!--[if ENDBLOCK]><![endif]--><?php endif; ?></span>
                        </span>
                        <span class="shrink-0 font-bold"><?php echo e(fmt_usd($item->line_usd)); ?></span>
                    </div>
                <?php endforeach; $__env->popLoop(); $loop = $__env->getLastLoop(); ?><?php if(\Livewire\Mechanisms\ExtendBlade\ExtendBlade::isRenderingLivewireComponent()): ?><!--[if ENDBLOCK]><![endif]--><?php endif; ?>
            </div>

            <div class="space-y-1.5 border-t border-gray-100 pt-3">
                <div class="flex justify-between">
                    <span class="text-gray-500"><?php echo e(__('cart.subtotal')); ?></span>
                    <span class="font-bold"><?php echo e(fmt_usd($totals['subtotal_usd'])); ?></span>
                </div>
                <?php if(\Livewire\Mechanisms\ExtendBlade\ExtendBlade::isRenderingLivewireComponent()): ?><!--[if BLOCK]><![endif]--><?php endif; ?><?php if($totals['discount_usd'] > 0): ?>
                    <div class="flex justify-between text-green-600">
                        <span><?php echo e(__('cart.discount')); ?></span>
                        <span class="font-bold">-<?php echo e(fmt_usd($totals['discount_usd'])); ?></span>
                    </div>
                <?php endif; ?><?php if(\Livewire\Mechanisms\ExtendBlade\ExtendBlade::isRenderingLivewireComponent()): ?><!--[if ENDBLOCK]><![endif]--><?php endif; ?>
                <?php if(\Livewire\Mechanisms\ExtendBlade\ExtendBlade::isRenderingLivewireComponent()): ?><!--[if BLOCK]><![endif]--><?php endif; ?><?php if($shipping_method === 'local'): ?>
                    <div class="flex justify-between">
                        <span class="text-gray-500"><?php echo e(__('cart.shipping')); ?></span>
                        <span class="font-bold"><?php echo e($totals['shipping_usd'] > 0 ? fmt_usd($totals['shipping_usd']) : '—'); ?></span>
                    </div>
                <?php endif; ?><?php if(\Livewire\Mechanisms\ExtendBlade\ExtendBlade::isRenderingLivewireComponent()): ?><!--[if ENDBLOCK]><![endif]--><?php endif; ?>
            </div>

            <div class="border-t border-gray-100 pt-3">
                <div class="flex justify-between text-base">
                    <span class="font-extrabold"><?php echo e(__('cart.grand_total')); ?></span>
                    <span class="font-extrabold text-gold-600"><?php echo e(fmt_usd($totals['total_usd'])); ?></span>
                </div>
                <p class="mt-1 text-end text-xs text-gray-400"><?php echo e(fmt_syp($totals['total_syp'])); ?></p>
            </div>

            <?php if(\Livewire\Mechanisms\ExtendBlade\ExtendBlade::isRenderingLivewireComponent()): ?><!--[if BLOCK]><![endif]--><?php endif; ?><?php if($totals['has_wholesale']): ?>
                <p class="badge w-full justify-center bg-gold-100 text-gold-600"><?php echo e(__('checkout.wholesale_note')); ?></p>
            <?php endif; ?><?php if(\Livewire\Mechanisms\ExtendBlade\ExtendBlade::isRenderingLivewireComponent()): ?><!--[if ENDBLOCK]><![endif]--><?php endif; ?>

            <button wire:click="confirm" wire:loading.attr="disabled"
                    class="btn-gold w-full !py-3 text-base"
                    wire:loading.class="opacity-60">
                <span wire:loading.remove wire:target="confirm"><?php echo e(__('checkout.confirm')); ?></span>
                <span wire:loading wire:target="confirm">...</span>
            </button>
            <p class="text-center text-[11px] leading-5 text-gray-400">
                بتأكيدك الطلب سنتواصل معك في أسرع وقت لتأكيد التفاصيل — شكرًا لثقتك بشركة النداف 💛
            </p>
        </div>
    </div>
</div>
