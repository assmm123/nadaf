                ✓ اعتُمد هذا الطلب وخُتم بختم التوثيق الرسمي بتاريخ <?php echo e($order->stamped_at->format('Y/m/d — H:i')); ?><?php echo e($order->stampedBy ? ' بواسطة '.$order->stampedBy->name : ''); ?>

            <?php else: ?>
                هذا إيصال مبدئي لطلبك — ستتحول تلقائيًا إلى فاتورة نظامية معتمدة بختم التوثيق بعد اعتماد الإدارة للطلب
            <?php endif; ?><?php if(\Livewire\Mechanisms\ExtendBlade\ExtendBlade::isRenderingLivewireComponent()): ?><!--[if ENDBLOCK]><![endif]--><?php endif; ?>
        </div>

        <div class="body">
            <div class="meta">
                <div><span>التاريخ والوقت:</span> <?php echo e($order->created_at->format('Y/m/d — H:i')); ?></div>
                <div><span>الحالة:</span> <?php echo e(\App\Models\Order::statusLabel($order->status)); ?></div>
                <div><span>اسم العميل:</span> <?php echo e($order->user->name); ?></div>
                <div><span>هاتف العميل:</span> <?php echo e($order->user->phone); ?></div>
                <div><span>طريقة الاستلام:</span> <?php echo e($order->shipping_method === 'local' ? 'توصيل محلي' : 'استلام من المحل'); ?></div>
