                            <td><?php echo e($item->quantity); ?></td>
                            <td><?php echo e(fmt_usd($item->unit_price_usd)); ?></td>
                            <td><?php echo e(fmt_usd($item->total_price_usd)); ?></td>
                        </tr>
                    <?php endforeach; $__env->popLoop(); $loop = $__env->getLastLoop(); ?><?php if(\Livewire\Mechanisms\ExtendBlade\ExtendBlade::isRenderingLivewireComponent()): ?><!--[if ENDBLOCK]><![endif]--><?php endif; ?>
                </tbody>
            </table>

            <div class="totals">
                <div><span>المجموع الفرعي</span><span><?php echo e(fmt_usd($order->subtotal_usd)); ?></span></div>
