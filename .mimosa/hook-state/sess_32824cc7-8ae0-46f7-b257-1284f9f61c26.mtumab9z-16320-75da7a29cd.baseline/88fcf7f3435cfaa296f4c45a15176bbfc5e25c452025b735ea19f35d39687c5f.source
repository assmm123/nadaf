                <div class="grand"><span>الإجمالي</span><span><?php echo e(fmt_usd($order->total_usd)); ?></span></div>
                <div style="font-size:12px; color:#6b7a89;"><span></span><span><?php echo e(fmt_syp($order->total_syp)); ?> <span style="opacity:.7;">(1$ = <?php echo e(number_format($order->exchange_rate, 0)); ?>)</span></span></div>
            </div>

            <div class="foot-row">
                <div class="foot">
                    شكرًا لتسوقكم من متجر <?php echo e(setting('store_name_ar', 'نداف')); ?> — <?php echo e(setting('store_phone')); ?> — جميع الحقوق محفوظة © <?php echo e(date('Y')); ?>

                </div>
                <div class="stamp-holder">
